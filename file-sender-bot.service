[Unit]
Description=Telegram File Sender Bot
After=network.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/file_sender_bot
EnvironmentFile=/opt/file_sender_bot/.env
ExecStart=/opt/file_sender_bot/.venv/bin/python -m bot.main
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/file_sender_bot/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target

