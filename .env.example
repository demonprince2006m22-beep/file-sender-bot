# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Bot Owner Telegram numeric ID (Primary superadmin with user management rights)
# You can find your ID by sending a message to @userinfobot
OWNER_ID=123456789

# Comma-separated list of additional Admin Telegram numeric IDs
# Example: ADMIN_IDS=987654321,112233445
ADMIN_IDS=987654321

# Storage Channel ID (Private channel where files are kept)
# Channels typically have an ID starting with -100
# Example: STORAGE_CHANNEL_ID=-1001987654321
STORAGE_CHANNEL_ID=-1001987654321

# Database file path (SQLite)
DATABASE_PATH=data/bot.db

# Default link expiration in hours (0 = never expires)
DEFAULT_EXPIRY_HOURS=0

# Default per-user delivery limit (0 = unlimited downloads per user)
DEFAULT_DELIVERY_LIMIT=0

# Force subscription requirement enabled by default (true/false)
FORCE_SUB_ENABLED=true

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

